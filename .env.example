# Copy to .env and fill in. Never commit .env.
# PayPal SANDBOX only. Live credentials must never be used.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# Public base URL of this app (used for PayPal return/cancel URLs and webhooks)
APP_BASE_URL=http://localhost:8000

# AI: Gemini on Vertex AI (Application Default Credentials) - cheap Flash-Lite models only
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project
VERTEX_LOCATION=global
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# On Render: path to a service-account JSON secret file
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-sa.json
# Alternative backend: Google AI Studio
# GEMINI_API_KEY=your-gemini-api-key

# Salt used to hash plates that are not enrolled (occupancy counts only)
PLATE_HASH_SALT=change-me
DEMO_VAULT_ID=vault-id-from-a-sandbox-enrolment
