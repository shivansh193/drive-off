# Copy to .env and fill in. Never commit .env.
# PayPal SANDBOX only. Live credentials must never be used.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# Public base URL of this app (used for PayPal return/cancel URLs and webhooks)
APP_BASE_URL=http://localhost:8000

# AI (Gemini via AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Salt used to hash plates that are not enrolled (occupancy counts only)
PLATE_HASH_SALT=change-me
DEMO_VAULT_ID=vault-id-from-a-sandbox-enrolment
